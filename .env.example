# Copy this file to .env and fill in real values for your deployment.
# .env is loaded automatically by config.py (via python-dotenv) — nothing
# here needs to be exported in your shell manually. Never commit the real
# .env file — only this example.

# --- Environment: development | production | testing ---
# production refuses to start with the default SECRET_KEY below, on
# purpose — you must set a real one first.
APP_ENV=development

# --- Core Flask ---
# Generate a real one for anything beyond local testing, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-please
FLASK_DEBUG=false

# --- Database ---
# Defaults to sqlite:///hospital.db in the project root if unset.
# DATABASE_URL=sqlite:///hospital.db

# --- Sessions ---
# How many minutes of inactivity before a shared clinic terminal is
# logged out automatically.
SESSION_TIMEOUT_MINUTES=20
# Set true once this is served over HTTPS — until then, leave false or
# the session cookie won't be sent and logins will silently fail.
SESSION_COOKIE_SECURE=false

# --- Dev server (run.py) ---
# 0.0.0.0 to reach it from other devices on the same network (other
# tablets/phones at the clinic); 127.0.0.1 for local-only.
HOST=127.0.0.1
PORT=5000

# --- Request size guard ---
MAX_CONTENT_LENGTH_MB=10

# --- New staff account default password (admin/routes.py:users_create) ---
# Shown to whoever creates the account, who's expected to hand it to the
# new staff member to change on first login.
DEFAULT_TEMP_PASSWORD=ChangeMe123!

# --- Site identity (canonical URLs, Open Graph tags, sitemap.xml) ---
# Update this once you're on a custom domain — used to build the
# absolute URLs search engines and social platforms expect.
SITE_URL=https://multihospitalmanagementsystem.pythonanywhere.com

# --- Pharmacy ---
# System-wide fallback only — each hospital can override this from the
# Pricing & System Settings page instead of touching this file.
LOW_STOCK_THRESHOLD_DEFAULT=10

# --- IntaSend (M-Pesa STK push subscription payments) ---
# Leave all of these unset to keep the local simulation mode for testing
# the subscription flow without live payment credentials.
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_TEST_MODE=true
# Must match the "Challenge" string configured on IntaSend's webhook
# settings page — used to verify webhook calls are genuinely from IntaSend.
INTASEND_WEBHOOK_CHALLENGE=
