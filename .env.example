
# =====================================================================
# Kenya DHA compliance settings (all optional — see /compliance page)
# =====================================================================
# Field-level encryption keys (AES-256-GCM). Format: keyid:base64key,keyid2:base64key
# Generate: python -c "import os,base64;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
# DATA_ENCRYPTION_KEYS=
# BLIND_INDEX_KEY=
# AUDIT_HMAC_KEY=
# MFA_ISSUER=MediCore HMIS
# MFA_REQUIRED_ROLES=CEO,Admin,Hospital Manager,System Maintainer
# AUDIT_RETENTION_YEARS=10
# EMERGENCY_ACCESS_MINUTES=60

# --- Kenya HIE: off | mock | live ---
# HIE_MODE=off
# HIE_BASE_URL=
# HIE_AUTH_TYPE=bearer            # bearer | basic | oauth2
# HIE_API_TOKEN=
# HIE_TOKEN_URL=
# HIE_CLIENT_ID=
# HIE_CLIENT_SECRET=
# HIE_AUTO_SEND=false
# HIE_INBOUND_SECRET=
# HIE_IDENTIFIER_BASE=https://medicore.example/identifier   # replace with DHA's published identifier system URIs

# --- HPT registry ---
# HPT_REGISTRY_URL=
# HPT_REGISTRY_TOKEN=

# --- Disease surveillance (KHIS / DHIS2): off | mock | live ---
# SURVEILLANCE_MODE=off
# SURVEILLANCE_URL=
# SURVEILLANCE_TOKEN=

# --- Digital Health ID sign-in (OpenID Connect) ---
# DHA_OIDC_ISSUER=
# DHA_OIDC_CLIENT_ID=
# DHA_OIDC_CLIENT_SECRET=
# DHA_OIDC_REDIRECT_URI=
# DHA_OIDC_TRUST_MFA=false

# --- Backups ---
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=35
# BACKUP_OFFSITE_DIR=
# BACKUP_S3_BUCKET=
# HIE_BUNDLE_PATH=/Bundle
# HIE_PULL_PATH=/Patient?identifier={system}|{value}
# HPT_SEARCH_PATH=/products?search={q}
# FORCE_HTTPS=false
# IDLE_LOGOUT_MINUTES=15
# SURVEILLANCE_PATH_NOTIFY=/notifications
# SURVEILLANCE_PATH_WEEKLY=/dataValueSets
# SURVEILLANCE_PATH_QUALITY=/dataValueSets
